# ─── Database ─────────────────────────────────────────────────────────────────
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=locus_todo
DB_PORT=5432
DATABASE_URL=postgres://${DB_USER}:${DB_PASSWORD}@localhost:${DB_PORT}/${DB_NAME}

# ─── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your-random-secret-here
JWT_EXPIRES_IN=900

# ─── Server ────────────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
# development | production
NODE_ENV=development

# ─── Dev tools ─────────────────────────────────────────────────────────────────
# Enabled automatically when NODE_ENV=development.
# Exposes POST /api/dev/tick — manually trigger scheduler with any date.
# Set NODE_ENV=production to disable completely.
DEV_TOOLS=true

# ─── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Firebase (for push notifications) ────────────────────────────────────────
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# DEV USER
# dev@locus.dev / dev123456

# ─── Production (docker-compose.prod.yml) ──────────────────────────────────────
# Full public URL of this app (adapter-node uses this for CORS/cookies)
ORIGIN=https://locus.example.com
# URL the browser uses to reach the API
PUBLIC_API_URL=https://locus.example.com
# Your domain for nginx TLS config
DOMAIN=locus.example.com
# Set automatically in GitHub Actions; override locally if needed
GITHUB_REPOSITORY=your-github-user/locus-todo
IMAGE_TAG=latest