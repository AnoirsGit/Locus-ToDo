{
  "name": "@locus/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "db:migrate": "node --env-file=../../.env --import tsx/esm src/db/migrate.ts",
    "db:seed": "node --env-file=../../.env --import tsx/esm src/db/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@fastify/jwt": "^9.0.0",
    "@fastify/redis": "^7.0.0",
    "@locus/shared": "workspace:*",
    "argon2": "^0.44.0",
    "fastify": "^5.0.0",
    "luxon": "^3.7.2",
    "node-cron": "^4.2.1",
    "postgres": "^3.4.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0"
  }
}
